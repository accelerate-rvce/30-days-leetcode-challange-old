# Accelerate — 30 Days of LeetCode
# Copy to apps/api/.env (never commit real secrets)

# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
EVENT_TIMEZONE=Asia/Kolkata

# --- Database (Supabase Postgres in production) ---
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Snapshot cadence for STORE=prisma (seconds between memory → Postgres writes + on shutdown)
SNAPSHOT_INTERVAL_SEC=60
# Storage backend: "memory" (default, local dev/test) or "prisma" (production with DATABASE_URL)
STORE=memory

# --- Auth / sessions ---
SESSION_SECRET=change-me-to-32-plus-random-chars-minimum
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Registration ---
REGISTRATION_MODE=WAITLIST
RVCE_EMAIL_DOMAIN=rvce.edu.in

# --- Email (configurable provider; SMTP default, log fallback) ---
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Accelerate <noreply@accelerate.rvce.edu.in>

# --- Verification provider ---
# "mock" for local dev/tests (explicitly marked). "http" for a real lookup service (see docs).
VERIFICATION_PROVIDER=mock
LEETCODE_GRAPHQL_URL=
VERIFICATION_TIMEOUT_MS=8000
VERIFICATION_CACHE_TTL_SEC=300
VERIFICATION_MAX_RECENT=50

# --- Jobs (protected cron endpoint) ---
JOB_SECRET=change-me-job-secret
# External scheduler should POST /api/v1/jobs/run with x-job-secret header every 5-15 min.

# --- Bootstrap superadmin (env only, never hardcoded) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Accelerate Admin

# --- Local dev seeding (memory store only; the server refuses this in production) ---
# SEED_DEMO=1 loads demo users (admin@rvce.edu.in / Password123!) + challenges
# into the RUNNING server's store at boot.
SEED_DEMO=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SITE_URL=http://localhost:5173
